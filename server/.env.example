PORT=3001
MONGODB_URI=mongodb+srv://usuario:password@cluster0.xxxxx.mongodb.net/clientflow?retryWrites=true&w=majority
# Dias sin compra para marcar un cliente como en riesgo / inactivo
ALERTA_DIAS_RIESGO=30
ALERTA_DIAS_INACTIVO=60
# Origen(es) del frontend que pueden llamar a la API (CORS). Varios: separados por coma.
CLIENT_ORIGIN=http://localhost:5173
# Limite de POST y DELETE por IP: RATE_LIMIT_MAX solicitudes cada RATE_LIMIT_VENTANA_MIN minutos
RATE_LIMIT_MAX=100
RATE_LIMIT_VENTANA_MIN=15
